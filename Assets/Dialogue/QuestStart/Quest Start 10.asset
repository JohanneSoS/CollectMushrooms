  charType: {fileID: 11400000, guid: 2718c5863d8c65a4aa712d078446307f, type: 2}
  lineTexts:
  - There you are! I was searching for you everywhere!
  - I found the humans and the place you probably came from!
  - South from here is a fence, I remembered that I saw pigs there once!
  - Be careful! Those humans can be dangerous... If you find any clue bring it to
    me!
